# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15"

# Direct (non-pooled) connection — required by Prisma Migrate / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- LLM providers (at least one required for generation) ---
# Groq: very fast open models, generous free tier — console.groq.com/keys
GROQ_API_KEY="gsk_..."
# OpenRouter: one key for Claude, GPT, Gemini and others — openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# --- Google Search Console + Keyword Planner ---
# One OAuth client covers both: Search Console (ranking queries) and the Google
# Ads Keyword Planner (search volume & competition). After setting the Ads keys
# below, RE-CONNECT Google so consent includes the Keyword Planner permission.
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:4330/api/google/callback"

# --- Google Ads Keyword Planner (free alternative to DataForSEO) ---
# Free search volume & competition. Needs a Google Ads account + an API
# developer token (basic access): https://developers.google.com/google-ads/api/docs/get-started/dev-token
# DEVELOPER_TOKEN: the Ads API developer token.
# CUSTOMER_ID: the Ads account id the lookups run under (digits only, no dashes).
# LOGIN_CUSTOMER_ID: only if that account sits under a manager (MCC) account.
# API_VERSION: override if Google deprecates the default (currently v21).
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_API_VERSION=""

# --- Scheduler (production only) ---
# Without this, /api/scheduler/tick accepts local requests only.
CRON_SECRET="a-long-random-string"

# --- Keywords Everywhere (accurate Google volume, instant key, cheap) ---
# Google Keyword Planner volume + competition with no approval board; ~$1 per
# 10k lookups (1 credit/keyword). Get a key at keywordseverywhere.com → API.
# COUNTRY: two-letter market, e.g. au / us / gb. Empty = global.
# DATASOURCE: gkp (Google Keyword Planner, accurate) or cli (clickstream).
KEYWORDS_EVERYWHERE_API_KEY=""
KEYWORDS_EVERYWHERE_COUNTRY=""
KEYWORDS_EVERYWHERE_CURRENCY="usd"
KEYWORDS_EVERYWHERE_DATASOURCE="gkp"

# --- Bing Webmaster Tools (free search volume, self-service key) ---
# The low-friction alternative to Google Ads: no approval board. Generate a key
# at Bing Webmaster Tools → Settings → API access, with the site verified there.
# BING_COUNTRY: two-letter market, e.g. au / us / gb. Empty = all markets.
# BING_LANGUAGE: e.g. en-US, en-GB, en-AU.
BING_WEBMASTER_API_KEY=""
BING_COUNTRY=""
BING_LANGUAGE="en-US"

# Keyword research — search volume and difficulty (app.dataforseo.com/api-access)
# Every research call is billed; nothing runs on a schedule.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- MCP server (HTTP transport only) ---
# The stdio transport needs none of this: the host spawns it locally and it
# inherits DATABASE_URL from this file.
#
# Over HTTP the server is a different proposition. Its tools crawl other
# people's websites, spend LLM and DataForSEO credits, and can publish to a
# live WordPress site, so /api/mcp refuses to serve in production without a
# token. Send it as `Authorization: Bearer <token>`.
MCP_TOKEN=""
# Browser origins allowed to reach /api/mcp, comma-separated hostnames.
# Defaults to localhost. Requests with no Origin header (every non-browser MCP
# client) are unaffected.
MCP_ALLOWED_ORIGINS=""
