# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=15"

# Direct (non-pooled) connection — required by Prisma Migrate / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- LLM providers (at least one required for generation) ---
# Groq: very fast open models, generous free tier — console.groq.com/keys
GROQ_API_KEY="gsk_..."
# OpenRouter: one key for Claude, GPT, Gemini and others — openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# --- Google Search Console ---
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:4330/api/google/callback"

# --- Scheduler (production only) ---
# Without this, /api/scheduler/tick accepts local requests only.
CRON_SECRET="a-long-random-string"

# Keyword research — search volume and difficulty (app.dataforseo.com/api-access)
# Every research call is billed; nothing runs on a schedule.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- MCP server (HTTP transport only) ---
# The stdio transport needs none of this: the host spawns it locally and it
# inherits DATABASE_URL from this file.
#
# Over HTTP the server is a different proposition. Its tools crawl other
# people's websites, spend LLM and DataForSEO credits, and can publish to a
# live WordPress site, so /api/mcp refuses to serve in production without a
# token. Send it as `Authorization: Bearer <token>`.
MCP_TOKEN=""
# Browser origins allowed to reach /api/mcp, comma-separated hostnames.
# Defaults to localhost. Requests with no Origin header (every non-browser MCP
# client) are unaffected.
MCP_ALLOWED_ORIGINS=""
