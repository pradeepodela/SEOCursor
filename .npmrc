# The MCP SDKs peer-depend on zod ^4.2.0 while this project's own schemas are
# zod 3. That is not a real conflict: zod 3.25 ships the v4 runtime on the
# `zod/v4` subpath, which is exactly what the SDK types import, so MCP code
# uses `zod/v4` and src/lib/schemas.ts stays on v3. npm only compares the root
# package version, so the peer check has to be told to stand down.
legacy-peer-deps=true
