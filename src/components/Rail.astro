---
import Icon from './Icon.astro';
interface Props {
  active: string;
  counts: { issues: number; criticalIssues: number; pages: number; keywords: number; ideas: number; drafts: number; scheduled: number };
  siteId: string;
  gscConnected: boolean;
}
const { active, counts, siteId, gscConnected } = Astro.props;
const q = `?site=${siteId}`;

/**
 * One flat navigation list — calendar-forward, matching the product shell.
 * Every item points at a real, backed page; labels follow the reference
 * vocabulary where that stays honest (Links → Backlinks, Content → Articles).
 */
const NAV = [
  { key: 'calendar', label: 'Calendar',  href: `/calendar${q}`, icon: 'calendar', count: counts.scheduled },
  { key: 'studio',   label: 'Articles',  href: `/studio${q}`,   icon: 'file',     count: counts.drafts },
  { key: 'ideas',    label: 'Blog Ideas', href: `/ideas${q}`,   icon: 'sparkle',  count: counts.ideas },
  { key: 'keywords', label: 'Keywords',  href: `/keywords${q}`, icon: 'key',      count: counts.keywords, dim: !gscConnected },
  { key: 'links',    label: 'Backlinks', href: `/links${q}`,    icon: 'link' },
  { key: 'pages',    label: 'Pages',     href: `/pages${q}`,    icon: 'grid',     count: counts.pages },
  { key: 'audit',    label: 'SEO Audit', href: `/audit${q}`,    icon: 'shield',   count: counts.issues, hot: counts.criticalIssues > 0 },
  { key: 'home',     label: 'Analytics', href: `/${q}`,         icon: 'chart',    isNew: true },
  { key: 'websites', label: 'Integrations', href: `/websites${q}`, icon: 'layers' },
  { key: 'mcp',      label: 'MCP Server', href: `/mcp${q}`,     icon: 'database' },
];

const FOOT = [
  { key: 'settings', label: 'Settings',      href: `/settings${q}`, icon: 'settings', hot: !gscConnected },
  { key: 'support',  label: 'Help & support', href: `/mcp${q}`,     icon: 'lifebuoy' },
  { key: 'docs',     label: 'Documentation',  href: `/mcp${q}`,     icon: 'book' },
];
---
<aside class="rail">
  <a class="rail-brand" href={`/${q}`}>
    <div class="rail-mark">S</div>
    <span class="rail-name">SEO Cursor</span>
  </a>

  <nav class="rail-scroll">
    {NAV.map((i) => (
      <a class={`nav-item ${active === i.key ? 'active' : ''}`} href={i.href}>
        <Icon name={i.icon} class="nav-icon" />
        <span>{i.label}</span>
        {i.isNew && <span class="nav-new">New</span>}
        {(i.count ?? 0) > 0 && <span class={`nav-count ${i.hot ? 'hot' : ''}`}>{i.count}</span>}
      </a>
    ))}

    <div class="rail-gap"></div>

    {FOOT.map((i) => (
      <a class={`nav-item ${active === i.key ? 'active' : ''}`} href={i.href}>
        <Icon name={i.icon} class="nav-icon" />
        <span>{i.label}</span>
        {i.hot && <span class="nav-count hot">!</span>}
      </a>
    ))}
  </nav>

  <div class="rail-foot">
    <a class="plan-row" href={`/studio${q}`}>
      <Icon name="file" size={14} class="plan-ic" />
      <span class="plan-val">{counts.drafts}</span>
      <span class="plan-lbl">articles</span>
    </a>
    <a class="plan-row" href={`/calendar${q}`}>
      <span class="plan-ic plan-ic-ai"><Icon name="zap" size={13} /></span>
      <span class="plan-val">{counts.scheduled}</span>
      <span class="plan-lbl">scheduled</span>
    </a>
    <a class="rail-user" href={`/settings${q}`}>
      <span class="rail-av">P</span>
      <span class="rail-user-meta">
        <span class="rail-user-name">Pradeep</span>
        <span class="rail-user-sub">Owner</span>
      </span>
    </a>
  </div>
</aside>
