---
import App from '../layouts/App.astro';
import CalendarBoard from '../islands/CalendarBoard';
import { db } from '../lib/db';
import { resolveSite } from '../lib/site';

const { site } = await resolveSite(Astro);
if (!site) return Astro.redirect('/connect');

const [rows, wp, keywordRows] = await Promise.all([
  db.calendarItem.findMany({
    where: { siteId: site.id },
    include: { blogIdea: true, content: true },
    orderBy: { date: 'asc' },
  }),
  db.wordPressConnection.findUnique({ where: { siteId: site.id } }),
  db.keyword.findMany({
    where: { siteId: site.id },
    orderBy: [{ volume: 'desc' }, { impressions: 'desc' }, { keyword: 'asc' }],
    take: 300,
    select: {
      id: true, keyword: true, volume: true, difficulty: true, competition: true,
      impressions: true, position: true, opportunity: true, intent: true, tracked: true,
    },
  }),
]);

const items = rows.map((r) => ({
  id: r.id,
  date: r.date.toISOString(),
  type: r.type,
  title: r.title,
  status: r.status,
  autoGenerate: r.autoGenerate,
  autoPublish: r.autoPublish,
  ranAt: r.ranAt?.toISOString() ?? null,
  runError: r.runError,
  ideaId: r.blogIdeaId,
  contentId: r.contentId,
  contentWords: r.content?.wordCount ?? null,
  wpUrl: r.content?.wpUrl ?? null,
  rationale: r.blogIdea?.rationale ?? null,
  targetQuery: r.blogIdea?.targetQuery ?? null,
}));

/** Turn a 0–1 competition (or difficulty) into the Low / Medium / High chip. */
function competitionLabel(competition: number | null, difficulty: number): 'Low' | 'Medium' | 'High' | 'N/A' {
  const score = competition != null ? competition * 100 : difficulty || 0;
  if (competition == null && !difficulty) return 'N/A';
  if (score < 34) return 'Low';
  if (score < 67) return 'Medium';
  return 'High';
}

const titleCase = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();

const keywords = keywordRows.map((k) => ({
  id: k.id,
  keyword: k.keyword,
  volume: k.volume,
  difficulty: k.difficulty,
  competition: competitionLabel(k.competition, k.difficulty),
  impressions: k.impressions,
  position: k.position,
  opportunity: titleCase(k.opportunity) as 'High' | 'Medium' | 'Low',
  source: (k.volume > 0 ? 'volume' : k.impressions > 0 ? 'gsc' : 'none') as 'volume' | 'gsc' | 'none',
  intent: k.intent,
  tracked: k.tracked,
}));
---
<App active="calendar" title="Content Calendar">
  <CalendarBoard
    client:load
    items={items}
    siteId={site.id}
    wpReady={!!wp}
    keywords={keywords}
  />
</App>
