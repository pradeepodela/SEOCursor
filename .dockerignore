# Never ship secrets into an image layer. Railway supplies these as real
# environment variables; a copied .env would both leak and silently override
# them, because lib/env.ts reads the file.
.env
.env.*
!.env.example

# Installed fresh in the image — a host node_modules carries native binaries
# and a Prisma engine built for the developer's platform, not this one.
node_modules/

# All build output. Everything here is regenerated by `npm run build` inside
# the image; copying a local build in would mask a broken one.
dist/
bin/
src/mcp/apps/dist/
.astro/

.git/
.gitignore
storage/
*.log
.DS_Store
README.md
